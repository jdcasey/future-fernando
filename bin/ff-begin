# begin — morning orientation. Resurfaces the starting point you chose at the
# previous working day's wrap, so you begin the day pointed the right way.
# Fire from a systemd user timer at 9am Mon-Fri. One-shot by design (a morning
# nudge, not a task-gate); upgrade to persistent nagging later if it helps.
set -uo pipefail

: "${FERN_STATE_DIR:=${XDG_STATE_HOME:-$HOME/.local/state}/ff}"
: "${FERN_BEGIN_KEY:=top}"         # which wrap answer to resurface (falls back to 'tomorrow')
: "${FERN_SOUND_ENABLED:=1}"
: "${FERN_BEGIN_DIALOG:=1}"        # 1 = zenity info popup (plus notify); 0 = notify only
: "${FERN_BEGIN_APPEND:=}"         # optional footer text appended to the notification
: "${FERN_DAY_RETAIN_DAYS:=7}"     # groom day files older than N days on begin (0 = keep all)

notify() { notify-send -a Fernando -u "${2:-normal}" "Fernando" "$1" 2>/dev/null || true; }
chime()  { [ "$FERN_SOUND_ENABLED" = 1 ] || return 0
           canberra-gtk-play -i "${1:-message}" >/dev/null 2>&1 || true; }

# Print the answer following a "<!-- wd:KEY -->" marker, up to the next blank line
# or heading.  extract KEY FILE
extract() {
  awk -v key="wd:$1" '
    index($0, key) { f=1; next }
    f {
      if ($0 ~ /^###/) exit
      if ($0 ~ /^[[:space:]]*$/) { if (s) exit; else next }
      s=1; print
    }' "$2"
}

today="$(date +%F).md"

# Most recent day file strictly before today (handles Mon -> Fri gaps, PTO, etc.).
latest=""
if [ -d "$FERN_STATE_DIR" ]; then
  latest=$(find "$FERN_STATE_DIR" -maxdepth 1 -name '????-??-??.md' -printf '%f\n' 2>/dev/null \
           | awk -v t="$today" '$0 < t' | sort | tail -1)
fi

chime message
if [ -z "$latest" ]; then
  notify "No saved starting point yet." normal
  exit 0
fi

answer=$(extract "$FERN_BEGIN_KEY" "$FERN_STATE_DIR/$latest")
# Bridge older day files (and skipped short answers): fall back to the full
# "tomorrow" answer when the preferred key is empty.
if [ -z "${answer//[[:space:]]/}" ] && [ "$FERN_BEGIN_KEY" != tomorrow ]; then
  answer=$(extract tomorrow "$FERN_STATE_DIR/$latest")
fi

day="${latest%.md}"
if [ -z "${answer//[[:space:]]/}" ]; then
  msg="No start-here note from $day."
else
  msg="Start here (from $day):

$answer"
fi
# Optional local footer, e.g. a nudge to open the journal. Empty = nothing added.
if [ -n "${FERN_BEGIN_APPEND//[[:space:]]/}" ]; then
  msg="$msg

$FERN_BEGIN_APPEND"
fi

if [ "$FERN_BEGIN_DIALOG" = 1 ] && command -v zenity >/dev/null 2>&1; then
  # Background so this one-shot service exits promptly; notify is the durable copy.
  zenity --info --title="Fernando" --width=480 --text="$msg" >/dev/null 2>&1 &
fi
notify "$msg" normal

# Groom the day-files directory: prune files older than FERN_DAY_RETAIN_DAYS.
# Runs after the read above, so today's resurfaced note is never at risk.
if [ "${FERN_DAY_RETAIN_DAYS:-0}" -gt 0 ] 2>/dev/null && [ -d "$FERN_STATE_DIR" ]; then
  find "$FERN_STATE_DIR" -maxdepth 1 -name '????-??-??.md' \
       -mtime +"$FERN_DAY_RETAIN_DAYS" -delete 2>/dev/null || true
fi
exit 0
