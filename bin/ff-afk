# ff-afk — tell Fern you're stepping away NOW. Silences the current
# nag immediately and opens a short grace window. The break is only *credited*
# (and the 60-min clock reset) once a real >=FERN_ACTIVITY_GAP quiet gap actually
# happens. Keep typing through the grace and the nag comes back — you can't
# silence it without actually taking the break.

set -uo pipefail

_self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
for _d in "${FERN_LIB:-}" \
          "${XDG_DATA_HOME:-$HOME/.local/share}/ff/lib" \
          "$(dirname "$_self")/../lib"; do
  if [ -n "$_d" ] && [ -f "$_d/ff-common.sh" ]; then FERN_LIB="$_d"; break; fi
done
[ -n "${FERN_LIB:-}" ] && [ -f "$FERN_LIB/ff-common.sh" ] || {
  echo "ff-afk: cannot find libs (set FERN_LIB)" >&2; exit 1; }
# shellcheck source=/dev/null
. "$FERN_LIB/ff-common.sh"

now=$(date +%s)

# Open the grace window and stop the current escalation. Do NOT reset the
# stretch clock here — only a real quiet gap (detected by ff-tick)
# credits the break, so this can't be used to cheat the guard.
printf '%s\n' "$(( now + FERN_BREAK_GRACE ))" > "$FERN_STATE_DIR/grace_until"
rm -f "$FERN_STATE_DIR/nag_level" "$FERN_STATE_DIR/break_pending"

# Dismiss the on-screen banner if there is one.
id=$(cat "$FERN_STATE_DIR/notif_id" 2>/dev/null || true)
if [ -n "${id:-}" ] && [ "$id" != 0 ]; then
  gdbus call --session \
    --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.CloseNotification "$id" \
    >/dev/null 2>&1 || true
fi
rm -f "$FERN_STATE_DIR/notif_id"

grace_min=$(( FERN_BREAK_GRACE / 60 ))
gap_min=$(( FERN_ACTIVITY_GAP / 60 ))
echo "Stepping away — nag silenced. Actually take the break: a real ${gap_min}-min"
echo "quiet gap credits it and resets the clock. Keep typing and the reminder"
echo "returns in ~${grace_min} min."
