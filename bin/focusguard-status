# focusguard-status — human-readable snapshot of the current focus/break state.

set -uo pipefail

_self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
for _d in "${FG_LIB:-}" \
          "${XDG_DATA_HOME:-$HOME/.local/share}/focusguard/lib" \
          "$(dirname "$_self")/../lib"; do
  if [ -n "$_d" ] && [ -f "$_d/fg-common.sh" ]; then FG_LIB="$_d"; break; fi
done
[ -n "${FG_LIB:-}" ] && [ -f "$FG_LIB/fg-common.sh" ] || {
  echo "focusguard-status: cannot find libs (set FG_LIB)" >&2; exit 1; }
# shellcheck source=/dev/null
. "$FG_LIB/fg-common.sh"
# shellcheck source=/dev/null
. "$FG_LIB/fg-llm.sh"

now=$(date +%s)
away=$(fg_break_away_seconds)

# Which signal is actually in play, for the status line.
if [ "$FG_PRESENCE" != typed ] && fg_idle_seconds >/dev/null 2>&1; then
  src="desktop idle"
else
  src="typed prompt (FG_PRESENCE=$FG_PRESENCE)"
fi

fmt() { printf '%dm %ds' $(( $1 / 60 )) $(( $1 % 60 )); }

echo "focusguard status  (as of $(date '+%Y-%m-%d %H:%M:%S'))"
echo "  presence      : $(fmt "$away") since last activity ($src)"

grace_until=$(cat "$FG_STATE_DIR/grace_until" 2>/dev/null || echo 0)
if [ "$away" -ge "$FG_ACTIVITY_GAP" ]; then
  echo "  state         : on a break / idle (clock reset)"
elif [ "$now" -lt "$grace_until" ]; then
  left=$(( grace_until - now ))
  echo "  state         : afk grace — quiet for $(fmt "$left") (step away to credit it)"
else
  start=$(cat "$FG_STATE_DIR/stretch_start" 2>/dev/null || echo "$now")
  active=$(( now - start ))
  if [ "$active" -ge "$FG_BREAK_INTERVAL" ]; then
    over=$(( active - FG_BREAK_INTERVAL ))
    lvl=$(cat "$FG_STATE_DIR/nag_level" 2>/dev/null || echo 0)
    echo "  state         : BREAK OVERDUE by $(fmt "$over") (nag level $lvl)"
    echo "  -> run 'afk' when you step away"
  else
    left=$(( FG_BREAK_INTERVAL - active ))
    echo "  state         : active $(fmt "$active"); next reminder in ~$(fmt "$left")"
  fi
fi

ncap=$(find "$FG_STATE_DIR/captured" -type f 2>/dev/null | wc -l | tr -d ' ')
echo "  sessions seen : $ncap tracked for capture"
echo "  capture llm   : $(fg_llm_describe)"
