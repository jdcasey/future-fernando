# wrap — end-of-day extraction sequence (design draft, incubating).
#
# Walks a fixed sequence of interview questions, each delivered as a zenity popup
# that re-shows every ~2 min (the nag) until answered. Questions advance on a
# ~10-min rhythm but never before their slot AND never past an unanswered one
# ("hold rhythm" + "keep nagging"). After the last answer it runs the
# save-progress hook, then a final "you're done" notification.
#
# Trigger this from a systemd user timer at 15:15 Mon-Fri (see systemd/). For
# testing, run with --now (start immediately) and a short interval, e.g.:
#   FERN_INTERVAL_MIN=1 FERN_NAG_SEC=20 ff-wrap --now
set -uo pipefail

# ---- config (env-overridable; a config file can be added later) -------------
: "${FERN_STATE_DIR:=${XDG_STATE_HOME:-$HOME/.local/state}/ff}"
: "${FERN_START:=15:15}"          # clock time the sequence anchors to
: "${FERN_INTERVAL_MIN:=10}"      # spacing between question slots (minutes)
: "${FERN_NAG_SEC:=120}"          # re-show the popup this often until answered
: "${FERN_HARD_STOP_MIN:=120}"    # safety backstop: stop nagging N min after start
: "${FERN_SOUND_ENABLED:=1}"
# Step 4 hook (REQUIRED). Run with FERN_ANSWERS_FILE exported (the day's Q/A
# markdown). The interview is pointless if its answers can't be persisted, so wrap
# refuses to run without one (see the preflight below). Wire it either here, or by
# dropping an executable at FERN_SAVE_PROGRESS_HOOK.
: "${FERN_SAVE_PROGRESS_CMD:=}"
: "${FERN_SAVE_PROGRESS_HOOK:=$HOME/.local/bin/ff-save-progress-hook}"
# Step 5 hook ("have a good evening"). If set, it is run instead of the plain
# one-shot notify — the seam for composing a presence-aware persistent clock-off
# nag (e.g. a Fern 'ff-goodnight'). Empty = a single notification.
: "${FERN_GOODNIGHT_CMD:=}"

# The interview. Each entry is "key|kind|question": the key is a stable marker
# written into the day file so other tools (e.g. begin) can extract a specific
# answer even if the wording changes; kind is the input widget — "entry" for a
# single line, "multi" for a multi-line box (bullet lists welcome).
QUESTIONS=(
  "done|entry|It's almost time to be done today. What did you get done?"
  "tomorrow|multi|What's most important to start with tomorrow? Check your calendar. Bullet lists welcome — this goes to your day file/journal in full."
  "top|entry|In one line: the 1–2 things to start with first. This is what tomorrow morning's reminder shows."
  "special|entry|Are there any special items that should be included in today's summary?"
)

# Seeded into multi-line boxes as a header/prompt (this zenity's --text-info has
# no label option); everything the user types goes below it and we strip the rest.
MULTILINE_SEP=">>> type your answer below (bullet lists welcome) <<<"

START_NOW=0
[ "${1:-}" = "--now" ] && START_NOW=1

command -v zenity >/dev/null 2>&1 || { echo "wrap: zenity is required" >&2; exit 1; }

FERN_LOG_DIR="$FERN_STATE_DIR/log"
mkdir -p "$FERN_STATE_DIR" "$FERN_LOG_DIR" 2>/dev/null || true
day_file="$FERN_STATE_DIR/$(date +%F).md"

now() { date +%s; }

notify() {
  notify-send -a Fernando -u "${2:-normal}" "Fernando" "$1" 2>/dev/null || true
}

chime() {
  [ "$FERN_SOUND_ENABLED" = 1 ] || return 0
  canberra-gtk-play -i "${1:-message}" >/dev/null 2>&1 || true
}

# ---- preflight: a save-progress hook is REQUIRED ----------------------------
# The interview only earns its interruption if the answers can be persisted, so
# refuse to run without a hook. Accept either FERN_SAVE_PROGRESS_CMD (a command,
# e.g. wrapped in `timeout`) or an executable dropped at FERN_SAVE_PROGRESS_HOOK.
if [ -z "$FERN_SAVE_PROGRESS_CMD" ] && [ -x "$FERN_SAVE_PROGRESS_HOOK" ]; then
  FERN_SAVE_PROGRESS_CMD="$FERN_SAVE_PROGRESS_HOOK"
fi
if [ -z "$FERN_SAVE_PROGRESS_CMD" ]; then
  msg="No save-progress hook configured — refusing to run the wrap interview (the answers would have nowhere to go). Provide an executable at $FERN_SAVE_PROGRESS_HOOK, or set FERN_SAVE_PROGRESS_CMD. See the README."
  echo "wrap: $msg" >&2
  notify "$msg" critical
  exit 1
fi

# Anchor: today at FERN_START, or now if --now.
if [ "$START_NOW" = 1 ]; then
  start_epoch=$(now)
else
  start_epoch=$(date -d "today $FERN_START" +%s 2>/dev/null) || start_epoch=$(now)
fi
hard_stop=$(( start_epoch + FERN_HARD_STOP_MIN * 60 ))

# Ask one question, re-showing every FERN_NAG_SEC until a non-empty answer is
# given, or the hard backstop is hit. Prints the answer on stdout; returns 1 if
# the backstop aborted the sequence.
ask_until_answered() {
  local kind="$1" q="$2" ans rc first=1
  while :; do
    if [ "$(now)" -ge "$hard_stop" ]; then
      notify "Stopping for now — backstop reached. Nothing was saved." critical
      return 1
    fi
    [ "$first" = 1 ] && chime message || { chime dialog-warning; notify "Still waiting: $q" critical; }
    first=0
    if [ "$kind" = multi ]; then
      # Seed the question into the editable box (no label option here), then
      # strip the header back off so only the typed answer remains.
      ans=$(printf '%s\n\n%s\n\n' "$q" "$MULTILINE_SEP" \
            | zenity --text-info --editable --title="Fernando" \
                     --width=560 --height=340 --timeout="$FERN_NAG_SEC" 2>/dev/null)
      rc=$?
      if [[ $ans == *"$MULTILINE_SEP"* ]]; then ans="${ans#*"$MULTILINE_SEP"}"; fi
      ans="${ans#"${ans%%[![:space:]]*}"}"   # ltrim
      ans="${ans%"${ans##*[![:space:]]}"}"   # rtrim
    else
      ans=$(zenity --entry --title="Fernando" --width=520 \
                   --text="$q" --timeout="$FERN_NAG_SEC" 2>/dev/null)
      rc=$?
    fi
    # rc 0 = OK; 1 = cancel; 5 = timeout. Only a non-empty OK counts.
    if [ "$rc" = 0 ] && [ -n "${ans//[[:space:]]/}" ]; then
      printf '%s\n' "$ans"
      return 0
    fi
    # otherwise loop: nag and re-show
  done
}

# ---- run the sequence -------------------------------------------------------
{
  printf '# Wrap — %s\n\n' "$(date '+%A %Y-%m-%d')"
} >> "$day_file"

i=0
for entry in "${QUESTIONS[@]}"; do
  key="${entry%%|*}"; rest="${entry#*|}"; kind="${rest%%|*}"; q="${rest#*|}"
  slot=$(( start_epoch + i * FERN_INTERVAL_MIN * 60 ))
  # Hold the rhythm: never pose a question before its slot.
  while [ "$(now)" -lt "$slot" ]; do
    sleep 15
    [ "$(now)" -ge "$hard_stop" ] && { notify "Wrap stopped (backstop)." critical; exit 1; }
  done

  answer=$(ask_until_answered "$kind" "$q") || exit 1
  {
    printf '### %s\n<!-- wd:%s -->\n\n%s\n\n' "$q" "$key" "$answer"
  } >> "$day_file"
  i=$(( i + 1 ))
done

# ---- step 4: save-progress hook ---------------------------------------------
# The hook is an unattended headless run, so capture EVERYTHING for diagnosis:
# full stdout+stderr to a dated log, and a keyed result line in the day file
# for the record.
notify "Saving today's progress…"
chime message
sp_log="$FERN_LOG_DIR/save-progress-$(date +%F).log"
# A hook is guaranteed by the preflight, so always run it.
{
  printf '===== save-progress %s =====\n' "$(date --iso-8601=seconds)"
  printf 'cmd: %s\n' "$FERN_SAVE_PROGRESS_CMD"
  printf 'answers-file: %s\n\n' "$day_file"
} >> "$sp_log"
FERN_ANSWERS_FILE="$day_file" bash -c "$FERN_SAVE_PROGRESS_CMD" >> "$sp_log" 2>&1
sp_rc=$?
printf '\n----- exit %s at %s -----\n\n' "$sp_rc" "$(date --iso-8601=seconds)" >> "$sp_log"
{
  printf '### save-progress result\n<!-- wd:save_result -->\n\n'
  printf 'exit %s at %s — log: %s\n\n' "$sp_rc" "$(date --iso-8601=seconds)" "$sp_log"
} >> "$day_file"
if [ "$sp_rc" -eq 0 ]; then
  notify "Progress saved (exit 0). Log: $sp_log" normal
else
  notify "save-progress FAILED (exit $sp_rc) — see $sp_log" critical
fi

# ---- step 5: done -----------------------------------------------------------
chime complete
if [ -n "$FERN_GOODNIGHT_CMD" ]; then
  # Composable seam: hand off to a presence-aware persistent clock-off nag
  # (e.g. Fern's ff-goodnight). Falls back to a plain notify if unset.
  FERN_ANSWERS_FILE="$day_file" bash -c "$FERN_GOODNIGHT_CMD"
else
  notify "You're all done! Have a good evening!" normal
fi
exit 0
