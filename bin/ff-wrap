# wrap — end-of-day extraction sequence.
#
# Fires once on a weekday afternoon:
#   1. a heads-up notification ("almost time to wrap up"), FERN_LEAD_MIN minutes
#      before the interview, so you can find a stopping point;
#   2. the whole interview as a single zenity forms dialog — every question at
#      once, with NO time limit, so it sits untouched until you submit (a
#      re-showing popup would clobber an answer in progress);
#   3. the save-progress hook;
#   4. a nag-style "be done now" notification.
#
# Trigger this from a systemd user timer at the heads-up time Mon-Fri (see
# systemd/). For testing, skip the anchor wait and the lead:
#   FERN_LEAD_MIN=0 ff-wrap --now
set -uo pipefail

# ---- config (env-overridable; a config file can be added later) -------------
: "${FERN_STATE_DIR:=${XDG_STATE_HOME:-$HOME/.local/state}/ff}"
: "${FERN_START:=15:15}"          # clock time of the heads-up notification
: "${FERN_LEAD_MIN:=15}"          # minutes from the heads-up to the interview
: "${FERN_HARD_STOP_MIN:=120}"    # backstop for the pre-interview wait (guards a mis-set FERN_START on a manual launch)
: "${FERN_FORM_TIMEOUT_SEC:=3600}" # cap on the whole interview phase (0 = no cap); on expiry, save-progress runs WITHOUT interview answers
: "${FERN_SOUND_ENABLED:=1}"
# Step 3 hook (REQUIRED). Run with FERN_ANSWERS_FILE exported (the day's Q/A
# markdown). The interview is pointless if its answers can't be persisted, so wrap
# refuses to run without one (see the preflight below). Wire it either here, or by
# dropping an executable at FERN_SAVE_PROGRESS_HOOK.
: "${FERN_SAVE_PROGRESS_CMD:=}"
: "${FERN_SAVE_PROGRESS_HOOK:=$HOME/.local/bin/ff-save-progress-hook}"
# Step 4 hook ("be done now"). If set, it is run instead of the plain one-shot
# notify — the seam for composing a presence-aware persistent clock-off nag
# (e.g. a Fern 'ff-goodnight'). Empty = a single nag notification.
: "${FERN_GOODNIGHT_CMD:=}"

# The interview. Each entry is "key|kind|question": the key is a stable marker
# written into the day file so other tools (e.g. begin) can extract a specific
# answer even if the wording changes; kind ("entry"/"multi") only steers the
# zenity fallback's widget — the yad renderer gives every answer a full-width box.
# Avoid a ": " inside a question: with yad the label is passed as "question:LBL",
# and a trailing "…:TYPE" token could be misread as a field type.
QUESTIONS=(
  "done|entry|What did you get done today?"
  "tomorrow|multi|What's most important to start with tomorrow? Check your calendar. Bullet lists welcome — this goes to your day file/journal in full."
  "top|entry|In one line — the 1–2 things to start with first (tomorrow morning's reminder shows this)."
  "special|entry|Any special items that should be included in today's summary?"
)

# Field separator for the forms output. The ASCII unit separator won't occur in
# typed text, so multi-line answers and blank fields both survive the split.
FORM_SEP=$'\x1f'

START_NOW=0
[ "${1:-}" = "--now" ] && START_NOW=1

# The interview needs a dialog tool. Prefer yad (roomier, question-above-field
# layout); fall back to zenity's grid form.
HAVE_YAD=0; command -v yad    >/dev/null 2>&1 && HAVE_YAD=1
HAVE_ZENITY=0; command -v zenity >/dev/null 2>&1 && HAVE_ZENITY=1
if [ "$HAVE_YAD" = 0 ] && [ "$HAVE_ZENITY" = 0 ]; then
  echo "wrap: need 'yad' or 'zenity' to run the interview" >&2
  exit 1
fi

FERN_LOG_DIR="$FERN_STATE_DIR/log"
mkdir -p "$FERN_STATE_DIR" "$FERN_LOG_DIR" 2>/dev/null || true
day_file="$FERN_STATE_DIR/$(date +%F).md"

now() { date +%s; }

notify() {
  notify-send -a Fernando -u "${2:-normal}" "Fernando" "$1" 2>/dev/null || true
}

chime() {
  [ "$FERN_SOUND_ENABLED" = 1 ] || return 0
  canberra-gtk-play -i "${1:-message}" >/dev/null 2>&1 || true
}

# ---- preflight: a save-progress hook is REQUIRED ----------------------------
# The interview only earns its interruption if the answers can be persisted, so
# refuse to run without a hook. Accept either FERN_SAVE_PROGRESS_CMD (a command,
# e.g. wrapped in `timeout`) or an executable dropped at FERN_SAVE_PROGRESS_HOOK.
if [ -z "$FERN_SAVE_PROGRESS_CMD" ] && [ -x "$FERN_SAVE_PROGRESS_HOOK" ]; then
  FERN_SAVE_PROGRESS_CMD="$FERN_SAVE_PROGRESS_HOOK"
fi
if [ -z "$FERN_SAVE_PROGRESS_CMD" ]; then
  msg="No save-progress hook configured — refusing to run the wrap interview (the answers would have nowhere to go). Provide an executable at $FERN_SAVE_PROGRESS_HOOK, or set FERN_SAVE_PROGRESS_CMD. See the README."
  echo "wrap: $msg" >&2
  notify "$msg" critical
  exit 1
fi

# Anchor: today at FERN_START, or now if --now.
if [ "$START_NOW" = 1 ]; then
  start_epoch=$(now)
else
  start_epoch=$(date -d "today $FERN_START" +%s 2>/dev/null) || start_epoch=$(now)
fi
hard_stop=$(( start_epoch + FERN_HARD_STOP_MIN * 60 ))

# Present the WHOLE interview as one dialog — every question at once. It does NOT
# re-show on a short timer (that clobbered answers in progress); it just sits open.
# The only limit is the overall cap FERN_FORM_TIMEOUT_SEC, passed to the dialog as
# the remaining time so a left-open form auto-closes exactly at the cap. If you
# close/cancel it before the cap, it re-shows (the nag).
#
# Two renderers share one field separator (FORM_SEP, an ASCII unit separator that
# won't occur in typed text, so answers split cleanly):
#   yad (preferred) — question as a full-width label (:LBL) with a full-width
#     multi-line box (:TXT) below it, stacked. yad emits an EMPTY output field for
#     each :LBL, so answers land at odd indices; and it escapes newlines/tabs in
#     :TXT output as literal \n \t, which we unescape.
#   zenity (fallback) — a grid --forms dialog (label-left), one field per question.

# Undo yad's escaping of control chars in :TXT output (\n -> newline, \t -> tab).
# Safe for zenity too: if the text has no such literals the sed is a no-op.
unescape_yad() { printf '%s' "$1" | sed -e 's/\\t/\t/g' -e 's/\\n/\n/g'; }

# Fill the global `answers` (one entry per question, in order) from yad output.
# Returns 0 if at least one answer is non-empty.
parse_yad() {
  local raw="$1" joined i
  local -a f
  IFS="$FORM_SEP" read -r -d '' -a f < <(printf '%s' "$raw")
  answers=()
  for ((i=0; i<${#QUESTIONS[@]}; i++)); do
    answers+=("$(unescape_yad "${f[$((2*i+1))]:-}")")   # answer k at output index 2k+1
  done
  joined="${raw//$FORM_SEP/}"; joined="${joined//[[:space:]]/}"
  [ -n "$joined" ]
}

# Same, for zenity --forms output (one output field per question, no LBL empties).
parse_zenity() {
  local raw="$1" joined
  IFS="$FORM_SEP" read -r -d '' -a answers < <(printf '%s' "$raw")
  joined="${raw//$FORM_SEP/}"; joined="${joined//[[:space:]]/}"
  [ -n "$joined" ]
}

answers=()
run_interview() {
  local raw rc first=1 entry rest kind q remaining cap
  local -a a
  while :; do
    remaining=$(( interview_deadline - $(now) ))
    if [ "$remaining" -le 0 ]; then
      notify "No wrap answers within the cap — saving the day without them." critical
      return 2
    fi
    if [ "$first" = 1 ]; then
      chime message
    else
      chime dialog-warning
      notify "The wrap-up interview is still waiting." critical
    fi
    first=0
    cap=0; [ "${FERN_FORM_TIMEOUT_SEC:-0}" -gt 0 ] 2>/dev/null && cap=1
    if [ "$HAVE_YAD" = 1 ]; then
      a=(--form --columns=1 --scroll --width=680 --height=620 --title="Fernando"
         --text="Wrap-up interview — fill in what applies, then click OK."
         --separator="$FORM_SEP")
      [ "$cap" = 1 ] && a+=(--timeout="$remaining" --timeout-indicator=bottom)
      for entry in "${QUESTIONS[@]}"; do
        q="${entry#*|}"; q="${q#*|}"
        a+=(--field="$q:LBL" --field=":TXT")
      done
      raw=$(yad "${a[@]}" 2>/dev/null); rc=$?
      if [ "$rc" = 0 ] && parse_yad "$raw"; then return 0; fi
    else
      a=(--forms --title="Fernando"
         --text="Wrap-up interview — fill in what applies, then press OK."
         --separator="$FORM_SEP")
      [ "$cap" = 1 ] && a+=(--timeout="$remaining")
      for entry in "${QUESTIONS[@]}"; do
        rest="${entry#*|}"; kind="${rest%%|*}"; q="${rest#*|}"
        case "$kind" in
          multi) a+=(--add-multiline-entry="$q");;
          *)     a+=(--add-entry="$q");;
        esac
      done
      raw=$(zenity "${a[@]}" 2>/dev/null); rc=$?
      if [ "$rc" = 0 ] && parse_zenity "$raw"; then return 0; fi
    fi
    # closed/cancelled/timed-out or all-blank: loop (re-checks the cap at the top)
    sleep 2
  done
}

# ---- run the sequence -------------------------------------------------------
# Wait until the heads-up time (the timer normally fires us at FERN_START; this
# only bites on an early manual launch), then warn and sleep the lead.
while [ "$(now)" -lt "$start_epoch" ]; do
  sleep 15
  [ "$(now)" -ge "$hard_stop" ] && { notify "Wrap stopped (backstop)." critical; exit 1; }
done

notify "Almost time to wrap up the day. The interview opens in ${FERN_LEAD_MIN} min — start finding a stopping point." normal
chime message
sleep $(( FERN_LEAD_MIN * 60 ))

# Interview (one dialog, all questions), capped at FERN_FORM_TIMEOUT_SEC from the
# moment it opens. Past the cap with no answer, we still save the day (below),
# just without interview answers.
if [ "${FERN_FORM_TIMEOUT_SEC:-0}" -gt 0 ] 2>/dev/null; then
  interview_deadline=$(( $(now) + FERN_FORM_TIMEOUT_SEC ))
else
  interview_deadline=$(( $(now) + 315360000 ))   # ~10y = effectively no cap
fi
run_interview; iv_rc=$?

# Header for today, written after the interview resolves so an aborted lead
# leaves no stray file.
{
  printf '# Wrap — %s\n\n' "$(date '+%A %Y-%m-%d')"
} >> "$day_file"

if [ "$iv_rc" = 0 ]; then
  i=0
  for entry in "${QUESTIONS[@]}"; do
    key="${entry%%|*}"; rest="${entry#*|}"; q="${rest#*|}"
    ans="${answers[i]:-}"
    ans="${ans#"${ans%%[![:space:]]*}"}"   # ltrim
    ans="${ans%"${ans##*[![:space:]]}"}"   # rtrim
    {
      printf '### %s\n<!-- wd:%s -->\n\n%s\n\n' "$q" "$key" "$ans"
    } >> "$day_file"
    i=$(( i + 1 ))
  done
else
  # iv_rc == 2: cap reached with no answer — note it, then save the day anyway.
  {
    printf '_Interview not completed within the %d-min cap; saved without answers._\n\n' "$(( FERN_FORM_TIMEOUT_SEC / 60 ))"
  } >> "$day_file"
fi

# ---- step 3: save-progress hook ---------------------------------------------
# The hook is an unattended headless run, so capture EVERYTHING for diagnosis:
# full stdout+stderr to a dated log, and a keyed result line in the day file
# for the record.
notify "Saving today's progress…"
chime message
sp_log="$FERN_LOG_DIR/save-progress-$(date +%F).log"
# A hook is guaranteed by the preflight, so always run it.
{
  printf '===== save-progress %s =====\n' "$(date --iso-8601=seconds)"
  printf 'cmd: %s\n' "$FERN_SAVE_PROGRESS_CMD"
  printf 'answers-file: %s\n\n' "$day_file"
} >> "$sp_log"
FERN_ANSWERS_FILE="$day_file" bash -c "$FERN_SAVE_PROGRESS_CMD" >> "$sp_log" 2>&1
sp_rc=$?
printf '\n----- exit %s at %s -----\n\n' "$sp_rc" "$(date --iso-8601=seconds)" >> "$sp_log"
{
  printf '### save-progress result\n<!-- wd:save_result -->\n\n'
  printf 'exit %s at %s — log: %s\n\n' "$sp_rc" "$(date --iso-8601=seconds)" "$sp_log"
} >> "$day_file"
if [ "$sp_rc" -eq 0 ]; then
  notify "Progress saved (exit 0). Log: $sp_log" normal
else
  notify "save-progress FAILED (exit $sp_rc) — see $sp_log" critical
fi

# ---- step 4: be done (nag) --------------------------------------------------
chime complete
if [ -n "$FERN_GOODNIGHT_CMD" ]; then
  # Composable seam: hand off to a presence-aware persistent clock-off nag
  # (e.g. Fern's ff-goodnight). Falls back to a plain nag notify if unset.
  FERN_ANSWERS_FILE="$day_file" bash -c "$FERN_GOODNIGHT_CMD"
else
  notify "That's it — you're done for today. Wrap up and step away from the keyboard now, and nobody gets hurt!" critical
fi
exit 0
