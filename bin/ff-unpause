# ff-unpause — end an active ff-pause early. The break clock kept running while
# paused, so if you're already overdue the nag returns on the next tick.

set -uo pipefail

_self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
for _d in "${FERN_LIB:-}" \
          "${XDG_DATA_HOME:-$HOME/.local/share}/ff/lib" \
          "$(dirname "$_self")/../lib"; do
  if [ -n "$_d" ] && [ -f "$_d/ff-common.sh" ]; then FERN_LIB="$_d"; break; fi
done
[ -n "${FERN_LIB:-}" ] && [ -f "$FERN_LIB/ff-common.sh" ] || {
  echo "ff-unpause: cannot find libs (set FERN_LIB)" >&2; exit 1; }
# shellcheck source=/dev/null
. "$FERN_LIB/ff-common.sh"

now=$(date +%s)
pause_until=$(cat "$FERN_STATE_DIR/pause_until" 2>/dev/null || echo 0)
rm -f "$FERN_STATE_DIR/pause_until"

if [ "$now" -lt "$pause_until" ]; then
  echo "Pause ended. If you're past the break interval, the nag returns shortly."
else
  echo "No active pause."
fi
