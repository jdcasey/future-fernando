# fftf-status — human-readable snapshot of the current focus/break state, the
# presence signals in play, and (with --log) the rolling detection log.
#
#   fftf-status            snapshot
#   fftf-status --log [N]  tail the last N detection-log lines (default 40)

set -uo pipefail

_self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
for _d in "${FFTF_LIB:-}" \
          "${XDG_DATA_HOME:-$HOME/.local/share}/fftf/lib" \
          "$(dirname "$_self")/../lib"; do
  if [ -n "$_d" ] && [ -f "$_d/fftf-common.sh" ]; then FFTF_LIB="$_d"; break; fi
done
[ -n "${FFTF_LIB:-}" ] && [ -f "$FFTF_LIB/fftf-common.sh" ] || {
  echo "fftf-status: cannot find libs (set FFTF_LIB)" >&2; exit 1; }
# shellcheck source=/dev/null
. "$FFTF_LIB/fftf-common.sh"
# shellcheck source=/dev/null
. "$FFTF_LIB/fftf-llm.sh"

# --- --log: show the rolling detection log and exit --------------------------
if [ "${1:-}" = "--log" ]; then
  n="${2:-40}"
  f="$FFTF_LOG_DIR/fftf-$(date +%Y%m%d).log"
  if [ -f "$f" ]; then
    echo "== $f (last $n lines) =="
    tail -n "$n" "$f"
  else
    echo "No detection log yet for today ($f)."
    echo "(Logging is ${FFTF_LOG_ENABLED:+on}; a line is written each tick when enabled.)"
  fi
  exit 0
fi

now=$(date +%s)
away=$(fftf_break_away_seconds)

fmt() { printf '%dm %ds' $(( $1 / 60 )) $(( $1 % 60 )); }

echo "Fern status  (as of $(date '+%Y-%m-%d %H:%M:%S'))"

# --- presence signals: what's enabled and what each reads now ----------------
idle_now=$(fftf_idle_seconds 2>/dev/null || echo -)
mic="off"; fftf_audio_in_active  && mic="ON"
spk="off"; fftf_audio_out_active && spk="ON"
if [ "$FFTF_PRESENCE" = auto ]; then
  sig_desc="auto (idle, else typed)"
else
  sig_desc="$(fftf_presence_signals | tr ' ' ',' )"
  [ -z "${sig_desc//,}" ] && sig_desc="off (no ambient sensing)"
fi
echo "  presence      : $(fmt "$away") since present   [signals: $sig_desc]"
echo "  sensors       : idle=${idle_now}s  mic=${mic}  speaker=${spk}"

# --- break-guard state machine (mirrors fftf-tick) -----------------------------
pause_until=$(cat "$FFTF_STATE_DIR/pause_until" 2>/dev/null || echo 0)
grace_until=$(cat "$FFTF_STATE_DIR/grace_until" 2>/dev/null || echo 0)
if [ "$away" -ge "$FFTF_ACTIVITY_GAP" ]; then
  echo "  state         : on a break / idle (clock reset)"
elif [ "$now" -lt "$pause_until" ]; then
  left=$(( pause_until - now ))
  echo "  state         : PAUSED — quiet for $(fmt "$left") (clock still running; fftf-unpause to end)"
elif [ "$now" -lt "$grace_until" ]; then
  left=$(( grace_until - now ))
  echo "  state         : afk grace — quiet for $(fmt "$left") (step away to credit it)"
else
  start=$(cat "$FFTF_STATE_DIR/stretch_start" 2>/dev/null || echo "$now")
  active=$(( now - start ))
  if [ "$active" -ge "$FFTF_BREAK_INTERVAL" ]; then
    over=$(( active - FFTF_BREAK_INTERVAL ))
    lvl=$(cat "$FFTF_STATE_DIR/nag_level" 2>/dev/null || echo 0)
    echo "  state         : BREAK OVERDUE by $(fmt "$over") (nag level $lvl)"
    echo "  -> run 'fftf-afk' when you step away, or 'fftf-pause' if you can't yet"
  else
    left=$(( FFTF_BREAK_INTERVAL - active ))
    echo "  state         : active $(fmt "$active"); next reminder in ~$(fmt "$left")"
  fi
fi

ncap=$(find "$FFTF_STATE_DIR/captured" -type f 2>/dev/null | wc -l | tr -d ' ')
echo "  sessions seen : $ncap tracked for capture"
echo "  capture llm   : $(fftf_llm_describe)"
echo "  detection log : fftf-status --log   (rolling, ${FFTF_LOG_RETAIN_DAYS}-day retention)"
