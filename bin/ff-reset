# ff-reset — manually credit the break NOW and reset the stretch clock. This is
# the escape hatch for when the guard got it wrong: you actually took a break but
# a presence signal (a hot mic in a meeting, pointer drift pinning idle) held you
# "present," so the gap was never credited and the nag is stuck escalating.
#
# It is exactly the `credit-break` action ff-tick performs on a real quiet gap:
# clear the stretch clock, the nag escalation, and any pending/grace/pause state,
# and dismiss the on-screen banner. Unlike ff-afk (opens a grace window) and
# ff-pause (silences without crediting), this ends the stretch outright.
#
# Use it sparingly — it bypasses the "a real gap is the only thing that credits a
# break" rule by hand. To make that deliberate, it is gated: you must type the
# command name ("ff-reset") correctly three times in a row, and it refuses to run
# without an interactive terminal. If you find yourself running it often, the fix is
# the presence config (FERN_PRESENCE), not this command: drop a signal that keeps
# misreading absence as presence. See "Break guard details" in the README.

set -uo pipefail

_self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
for _d in "${FERN_LIB:-}" \
          "${XDG_DATA_HOME:-$HOME/.local/share}/ff/lib" \
          "$(dirname "$_self")/../lib"; do
  if [ -n "$_d" ] && [ -f "$_d/ff-common.sh" ]; then FERN_LIB="$_d"; break; fi
done
[ -n "${FERN_LIB:-}" ] && [ -f "$FERN_LIB/ff-common.sh" ] || {
  echo "ff-reset: cannot find libs (set FERN_LIB)" >&2; exit 1; }
# shellcheck source=/dev/null
. "$FERN_LIB/ff-common.sh"

# Triple-confirmation gate. ff-reset credits a break by hand, bypassing the "only a
# real gap counts" rule, so it is deliberately high-friction: you must type the
# command name correctly THREE times in a row. Any mismatch — or no terminal to type
# into — aborts without touching the clock. There is intentionally no bypass flag;
# the friction is the point (a speed bump against reflexively skipping real breaks).
confirm_word="ff-reset"
if [ ! -t 0 ] || [ ! -t 1 ]; then
  echo "ff-reset: needs an interactive terminal — it requires typing" >&2
  echo "          '$confirm_word' three times to confirm. Aborted, clock unchanged." >&2
  exit 2
fi
echo "ff-reset credits a break by hand and resets the stretch clock."
echo "Confirm by typing '$confirm_word' three times in a row (any slip aborts)."
for i in 1 2 3; do
  printf '  [%d/3] type %s: ' "$i" "$confirm_word"
  IFS= read -r reply || { echo; echo "ff-reset: input closed — aborted, clock unchanged."; exit 1; }
  if [ "$reply" != "$confirm_word" ]; then
    echo "ff-reset: got '$reply', expected '$confirm_word' — aborted, clock unchanged."
    exit 1
  fi
done

# Dismiss the on-screen banner if there is one.
id=$(cat "$FERN_STATE_DIR/notif_id" 2>/dev/null || true)
if [ -n "${id:-}" ] && [ "$id" != 0 ]; then
  gdbus call --session \
    --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.CloseNotification "$id" \
    >/dev/null 2>&1 || true
fi

# Credit the break: identical to ff-tick's credit-break branch.
rm -f "$FERN_STATE_DIR/stretch_start" "$FERN_STATE_DIR/nag_level" \
      "$FERN_STATE_DIR/break_pending" "$FERN_STATE_DIR/grace_until" \
      "$FERN_STATE_DIR/pause_until" "$FERN_STATE_DIR/notif_id"

interval_min=$(( FERN_BREAK_INTERVAL / 60 ))
echo "Break credited by hand — stretch clock reset. A fresh stretch starts now;"
echo "next reminder in ~${interval_min} min. (If you keep needing this, adjust"
echo "FERN_PRESENCE so a hot mic / idle drift stops reading as present.)"
