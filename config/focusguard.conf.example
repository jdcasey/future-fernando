# focusguard configuration — shell fragment, sourced by the scripts.
# Copy to  ${XDG_CONFIG_HOME:-~/.config}/focusguard/focusguard.conf  and edit.
# Every value below is optional; unset keys fall back to the built-in defaults.

# --- Where Claude Code keeps session transcripts -----------------------------
# FG_PROJECTS_DIR="$HOME/.claude/projects"

# --- Feature switches --------------------------------------------------------
# FG_BREAK_ENABLED=1        # 1=break reminders on, 0=off
# FG_CAPTURE_ENABLED=1      # 1=auto answer-capture on, 0=off

# --- Break guard timing (seconds) --------------------------------------------
# FG_BREAK_INTERVAL=3600    # continuous active time before a break is due (60m)
# FG_ACTIVITY_GAP=600       # quiet time that counts as a break / resets clock (10m)
# FG_BREAK_GRACE=300        # after 'break-start': quiet window before the nag returns
                            # if you didn't actually step away (5m)

# --- Break guard delivery ----------------------------------------------------
# FG_NOTIFY_STACK=0         # 0=one sticky banner that updates; 1=stack a new one each nag
# FG_SOUND_ENABLED=1        # play escalating sounds

# --- Answer capture ----------------------------------------------------------
# FG_CAPTURE_IDLE=480       # a session must be stale this long to trigger capture (8m)
# FG_CAPTURE_MAX_AGE=86400  # ignore sessions idle longer than this (24h)
# FG_CAPTURE_PER_TICK=2     # cap capture calls per tick (cost/latency guard)
# FG_CAPTURE_TIMEOUT=120    # per-capture LLM timeout (seconds)
# FG_CAPTURE_TAIL_BYTES=12000  # how much of the transcript tail to feed the model

# Where QUESTION-*.md files go. Empty = each session's own <project>/.temp/.
# Set an absolute path to funnel every capture into one central folder instead.
# FG_CAPTURE_DIR=""

# --- LLM backend (shared by all LLM-using features) --------------------------
# FG_LLM_BACKEND="claude"          # claude (hosted) | ollama (local, self-contained)
# FG_LLM_MODEL=""                  # optional: override whichever backend's model

# claude backend
# FG_CLAUDE_BIN="claude"           # absolute path recommended (install.sh sets this)
# FG_CLAUDE_MODEL="claude-haiku-4-5-20251001"

# ollama backend (fully local / offline / no cost)
# FG_OLLAMA_URL="http://localhost:11434"
# FG_OLLAMA_MODEL="llama3.2:3b"    # try llama3.1:8b, mistral, gemma2:2b, etc.
# FG_OLLAMA_NUM_CTX=8192           # raise if the transcript tail gets truncated
# FG_OLLAMA_KEEP_ALIVE="5m"        # how long ollama keeps the model warm
