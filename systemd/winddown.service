[Unit]
Description=winddown — end-of-day extraction sequence

[Service]
Type=simple
# Optional env (WD_SAVE_PROGRESS_CMD, WD_GOODNIGHT_CMD, timing overrides, …).
EnvironmentFile=-%h/.config/winddown/winddown.env
# Lives ~45 min while it walks the sequence; needs the desktop session env for
# zenity/notify-send (imported by install.sh, mirroring focusguard).
ExecStart=%h/.local/bin/winddown
