#
# One focusguard scan pass. Triggered by focusguard.timer.

[Unit]
Description=Focusguard scan — break guard + session answer capture
Documentation=https://github.com/jdcasey/focusguard
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/focusguard-tick
# Keep a single pass from hanging forever if headless capture wedges.
TimeoutStartSec=300
