#
# One Fern scan pass. Triggered by ff.timer.

[Unit]
Description=Fern scan — break guard + session answer capture
Documentation=https://github.com/jdcasey/future-fernando
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/ff-tick
# Keep a single pass from hanging forever if headless capture wedges.
TimeoutStartSec=300
